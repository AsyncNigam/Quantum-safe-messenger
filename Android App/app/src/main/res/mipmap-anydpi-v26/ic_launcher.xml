<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: renders the app logo bitmap.
     The 108dp canvas with 18dp safe zone (inset to 72dp) ensures
     the logo is properly masked by all launcher shapes. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/logo" />
</adaptive-icon>